# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Connect → Session pooler (port 5432). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string; signs login tokens. Required on Vercel.
JWT_SECRET=

# Google AI Studio key for "Scan LR photo" (optional; scanning is off without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
